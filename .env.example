# Copy to .env, which is gitignored. Read by tools/hw.py and the hardware tests.
#
# The devcontainer forwards 8123, so the default works from the WSL2 host.
HA_URL=http://localhost:8123

# Profile -> Security -> Long-lived access tokens, in the *devcontainer's* Home
# Assistant, not the production one.
HA_TOKEN=

# Hardware, added to the devcontainer by IP because mDNS discovery does not
# cross Docker Desktop's NAT. Only needed to add the device the first time.
ESPHOME_HOST=
ESPHOME_ENCRYPTION_KEY=
