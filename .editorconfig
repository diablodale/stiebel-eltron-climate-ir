# editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 88

[*.sh]
indent_size = 4

[*.{json,yaml,yml,md}]
indent_size = 2

# uv writes uv.lock with four-space indentation, so no rule claims otherwise here;
# only the file that is edited by hand is described.
[pyproject.toml]
indent_size = 2

# The protocol document quotes ESPHome capture logs verbatim, and 134 of those lines
# end in a single trailing space. They are the evidence the protocol was derived
# from, so an editor must not tidy them. The matching prek hook exclude is the second
# line of defence.
[*.md]
trim_trailing_whitespace = false
